bazel_dep(name = "aspect_rules_js", version = "0.0.0", dev_dependency = True)
local_path_override(
    module_name = "aspect_rules_js",
    path = "../..",
)

bazel_dep(name = "bazel_skylib", version = "1.5.0", dev_dependency = True)

pnpm = use_extension(
    "@aspect_rules_js//npm:extensions.bzl",
    "pnpm",
    dev_dependency = True,
)
pnpm.pnpm(
    name = "pnpm-old-version",
    pnpm_version = "9.1.1",
)
use_repo(pnpm, "pnpm-old-version")

yarn_lock = use_extension(
    "@aspect_rules_js//npm:extensions.bzl",
    "yarn_lock",
    dev_dependency = True,
)
yarn_lock.generate(
    name = "generated-pnpm-lock",
    data = ["//:package.json"],
    expected_pnpm_lock_sha256 = "257eb130f08d88a503fdcb118e4e33e78f979679f2ed4e405ad0838f1b7e2194",
    preupdate = ["//:transform_package_json.js"],
    quiet = False,
    use_pnpm = "@pnpm-old-version//:package/bin/pnpm.cjs",
    yarn_lock = "//:yarn.lock",
)
use_repo(yarn_lock, "generated-pnpm-lock")

npm = use_extension(
    "@aspect_rules_js//npm:extensions.bzl",
    "npm",
    dev_dependency = True,
)
npm.npm_translate_lock(
    name = "npm",
    npmrc = "//:.npmrc",
    pnpm_lock = "@generated-pnpm-lock//:pnpm-lock.yaml",
    quiet = False,
    verify_node_modules_ignored = "//:.bazelignore",
)
use_repo(npm, "npm")
